{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "playwright test",
    "format": "prettier --write",
    "fallow": "fallow --health-baseline fallow-baselines/health.json --fail-on-issues",
    "flight:sky": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/flight/register.mjs scripts/flight/render-sky.mts",
    "flight:sheet": "node scripts/flight/contact-sheet.mjs",
    "flight:bench": "node scripts/flight/benchmark.mjs",
    "flight:capture": "node scripts/flight/capture.mjs"
  },
  "dependencies": {
    "@contentful/rich-text-react-renderer": "^16.1.6",
    "@contentful/rich-text-types": "^17.2.5",
    "@vercel/analytics": "^1.6.1",
    "next": "16.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "vgpu": "^0.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vgpu/wgsl": "^0.6.0",
    "@webgpu/types": "^0.1.74",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "fallow": "^3.33.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
